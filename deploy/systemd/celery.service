[Unit]
Description=Celery worker for tutionplus
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
Type=simple
WorkingDirectory=/home/tutionplus/app/django/django_project
EnvironmentFile=/home/tutionplus/app/.env
Environment=DJANGO_SETTINGS_MODULE=django_project.settings_production
ExecStart=/home/tutionplus/venv/bin/celery -A django_project worker --loglevel=info --logfile=/home/tutionplus/logs/celery.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
