# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-digitalocean-ip,yourdomain.com

# Database (matches the postgres service name in docker-compose)
DB_NAME=tutionplus
DB_USER=postgres
DB_PASSWORD=choose_a_strong_password
DB_HOST=db
DB_PORT=5432

# Redis (matches the redis service name in docker-compose)
REDIS_URL=redis://redis:6379/0

# Email (Gmail SMTP)
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# GenAI / LLM APIs
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# Google Gemini
GOOGLE_API_KEY=your-google-gemini-api-key

# PDF / Celery
PDF_UPLOAD_PATH=./uploaded_pdfs
MAX_PDF_SIZE=52428800
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
